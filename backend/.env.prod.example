# 数据库
DB_USER=tmatch
DB_PASSWORD=change_this_strong_password
DB_NAME=tmatch

DATABASE_URL=postgresql+asyncpg://tmatch:change_this_strong_password@db:5432/tmatch
DATABASE_URL_SYNC=postgresql://tmatch:change_this_strong_password@db:5432/tmatch

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT
SECRET_KEY=change_this_to_a_random_64_char_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 应用
DEBUG=False
CORS_ORIGINS=https://your-domain.com

# Milvus
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION_NAME=job_vectors
MILVUS_RESUME_COLLECTION=resume_vectors

# MinIO
MINIO_ACCESS_KEY=change_this_minio_key
MINIO_SECRET_KEY=change_this_minio_secret

# 通义千问 API
TONGYI_API_KEY=your_tongyi_api_key
TONGYI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TONGYI_CHAT_MODEL=qwen-plus
TONGYI_VL_MODEL=qwen-vl-plus
